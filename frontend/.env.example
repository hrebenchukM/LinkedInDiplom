# Copy to `.env.local` before `npm run dev`.

# Empty = same-origin /api via Vite proxy (Docker :5000)
VITE_API_BASE_URL=

VITE_DEV_PROXY_TARGET=http://localhost:5000

# Optional explicit SignalR hub (default: same origin + /hubs/messaging)
# VITE_SIGNALR_HUB_URL=http://localhost:5000/hubs/messaging

# VITE_DEFAULT_PAGE_SIZE=10
# VITE_TOKEN_REFRESH_MARGIN_MS=60000
