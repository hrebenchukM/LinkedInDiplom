# Copy to `.env.local` before `npm run dev`.

# Empty = same-origin /api via Vite proxy
VITE_API_BASE_URL=

# Backend target for Vite dev proxy (/api, /uploads, /hubs). REST and SignalR must use the same host.
# Docker (default):          http://localhost:5000
# dotnet run (http profile): http://localhost:5282
# dotnet run (https profile):  https://localhost:7011
VITE_DEV_PROXY_TARGET=http://localhost:5000

# Optional explicit SignalR hub (default: same origin + /hubs/messaging)
# VITE_SIGNALR_HUB_URL=http://localhost:5000/hubs/messaging

# VITE_DEFAULT_PAGE_SIZE=10
# VITE_TOKEN_REFRESH_MARGIN_MS=60000
