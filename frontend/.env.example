# Copy to `.env.local` before `npm run dev`.

# API origin (no trailing slash). Empty = same-origin /api via Vite proxy.
VITE_API_BASE_URL=

# dotnet run profile "https"
# VITE_API_BASE_URL=https://localhost:7011

# Docker Compose API
# VITE_API_BASE_URL=http://localhost:5000

# Vite dev proxy when API runs locally: dotnet run → :5282
# VITE_DEV_PROXY_TARGET=http://localhost:5282

# Vite dev proxy when API runs in Docker (docker compose):
VITE_DEV_PROXY_TARGET=http://localhost:5000

# Offline UI — mock auth in browser only (dev server; ignored in `npm run build`)
# VITE_USE_MOCK_AUTH=true

# Demo guest button on auth screen (no JWT) — off by default
# VITE_ENABLE_GUEST=true

# OAuth SDK (AuthPage → POST /api/auth/google|facebook)
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# VITE_FACEBOOK_APP_ID=your-facebook-app-id

# Diploma fallback when OAuth SDK is not configured (apiDemoSocialLogin on real API).
# Enabled by default in dev; set false to disable. Production: opt-in with =true.
# VITE_ENABLE_DEMO_SOCIAL_FALLBACK=false

# Password for preset Google/Facebook demo accounts (andrii.rotar / timur.yamchuk)
# VITE_DEMO_SOCIAL_PASSWORD=LinkUpDemo2024!

# --- Production deploy ---
# Build with real API (see docs/E2E_CHECKLIST.md):
#   VITE_API_BASE_URL=https://api.your-domain.com
# Leave empty when nginx serves SPA + proxies /api on same host.
#
# Backend must list frontend origin in Cors:AllowedOrigins
# (backend/Facade.API/appsettings.Production.json).
#
# Never enable in production builds:
# VITE_USE_MOCK_AUTH=true
