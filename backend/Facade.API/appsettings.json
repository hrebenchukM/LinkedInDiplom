{
    "FileStorage": {
        "UploadsRootPath": ""
    },

    "Cors": {
        "AllowedOrigins": []
    },

    "ConnectionStrings": {
        // Строка подключения к PostgreSQL
        // Host = где база (localhost = на твоём компьютере)
        // Port = порт PostgreSQL
        // Database = имя базы
        // Username/Password = логин/пароль
        "DefaultConnection": "Host=localhost;Port=5432;Database=linkedin_dev;Username=postgres;Password=postgres"
    },
    "JwtSettings": {
        // Секретный ключ для подписи JWT (должен быть длинный)
        "SecretKey": "your-secret-key-min-32-characters-long-change-this-in-production",

        // Кто выдал токен
        "Issuer": "LinkedInAPI",

        // Для кого токен
        "Audience": "LinkedInClients",

        // Время жизни access token (в минутах)
        "AccessTokenExpirationMinutes": 15,

        // Время жизни refresh token (в днях)
        "RefreshTokenExpirationDays": 7
    },

    "Logging": {
        "LogLevel": {
            // Общий уровень логов
            "Default": "Information",

            // Логи ASP.NET Core
            "Microsoft.AspNetCore": "Warning"
        }
    },

    // Разрешённые хосты (обычно просто *)
    "AllowedHosts": "*"
}