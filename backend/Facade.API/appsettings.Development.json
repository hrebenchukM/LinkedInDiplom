{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Information"
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=linkedin_dev;Username=postgres;Password=postgres"
    },
    "JwtSettings": {
        "SecretKey": "development-secret-key-min-32-characters-for-testing-only",
        "Issuer": "LinkedInAPI",
        "Audience": "LinkedInClients",
        "AccessTokenExpirationMinutes": 60,
        "RefreshTokenExpirationDays": 30
    }
}

//development-файл переопределяет настройки только для локальной разработки.
//В production одни настройки

//Например:"AccessTokenExpirationMinutes": 15

//Короткий токен = безопаснее.

//А во время разработки неудобно

//Если токен живёт 15 минут:

//постоянно логиниться
//постоянно обновлять JWT
//неудобно тестировать Swagger

//Поэтому в development:"AccessTokenExpirationMinutes": 60