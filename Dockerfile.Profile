# Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy solution file
COPY ["LinkedIn.sln", "./"]

# Profile module
COPY ["backend/Profile/Profile.Contracts/Profile.Contracts.csproj", "backend/Profile/Profile.Contracts/"]
COPY ["backend/Profile/Profile.DataAccess/Profile.DataAccess.csproj", "backend/Profile/Profile.DataAccess/"]
COPY ["backend/Profile/Profile.Services/Profile.Services.csproj", "backend/Profile/Profile.Services/"]
COPY ["backend/Profile/Profile.DI/Profile.DI.csproj", "backend/Profile/Profile.DI/"]
COPY ["backend/Profile/Profile.API/Profile.API.csproj", "backend/Profile/Profile.API/"]

# Restore dependencies
RUN dotnet restore "backend/Profile/Profile.API/Profile.API.csproj"

# Copy everything else
COPY . .

# Publish Profile.API
WORKDIR "/src/backend/Profile/Profile.API"
RUN dotnet publish "Profile.API.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

EXPOSE 8080

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "Profile.API.dll"]